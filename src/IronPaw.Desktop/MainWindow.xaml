<Window x:Class="IronPaw.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IronPaw Agent Desktop"
        Height="760"
        Width="1200"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1D2A3C" Offset="0" />
            <GradientStop Color="#152233" Offset="0.55" />
            <GradientStop Color="#0D1727" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#CCF7F9FC" />
        <SolidColorBrush x:Key="PanelEdgeBrush" Color="#664D5D77" />
        <Style x:Key="TimelineCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="3,3" />
        </Style>
        <Style x:Key="TimelineStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource TimelineCellStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Accepted}" Value="True">
                    <Setter Property="Foreground" Value="#216145" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter Property="Foreground" Value="#9F3B19" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#6D7A9D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FCFEFF" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#6D7A9D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FCFEFF" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,4,10,0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#174A84" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0D355F" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border CornerRadius="14" Padding="18" Background="#AA091221" BorderBrush="#336E86AB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="IronPaw Agent Control Plane" FontSize="28" FontWeight="Bold" Foreground="White" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Headless orchestration, tool policy pipeline, and provider routing"
                               FontSize="14"
                               Foreground="#D2E4FF" />
                    <TextBlock x:Name="WorkspaceTextBlock" Foreground="#D2E4FF" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="12" Padding="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Session Key" FontWeight="SemiBold" />
                        <TextBox x:Name="SessionKeyTextBox" Grid.Row="1" Text="default" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Provider" FontWeight="SemiBold" />
                                <ComboBox x:Name="ProviderComboBox" SelectionChanged="ProviderComboBox_OnSelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="local" />
                                    <ComboBoxItem Content="openai" />
                                    <ComboBoxItem Content="ollama" />
                                    <ComboBoxItem Content="lmstudio" />
                                    <ComboBoxItem Content="anthropic" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Model" FontWeight="SemiBold" />
                                <TextBox x:Name="ModelTextBox" Text="rule-based-v1" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Margin="0,0,0,4"
                                   Foreground="#35435C"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Text="OpenAI: OPENAI_API_KEY | Anthropic: ANTHROPIC_API_KEY | Ollama: OLLAMA_BASE_URL (+ optional OLLAMA_API_KEY) | LM Studio: LMSTUDIO_BASE_URL (+ optional LMSTUDIO_API_KEY)." />

                        <WrapPanel Grid.Row="4">
                            <Button x:Name="RunButton" Content="Run Agent" Click="RunButton_OnClick" />
                            <Button x:Name="PauseActiveButton" Content="Pause" Click="PauseActiveButton_OnClick" IsEnabled="False" />
                            <Button x:Name="CancelButton" Content="Cancel permanently" Click="CancelButton_OnClick" IsEnabled="False" Background="#B85A2A" BorderBrush="#91461F" />
                        </WrapPanel>

                        <Button Grid.Row="5" Content="Workflow settings…" Click="OpenSettings_OnClick" HorizontalAlignment="Left" Margin="0,10,0,0" />

                        <Grid Grid.Row="6" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Prompt" FontWeight="SemiBold" />
                            <TextBox x:Name="PromptTextBox"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas" />

                            <TextBlock Grid.Row="2" Text="Assistant Output" FontWeight="SemiBold" />
                            <TextBox x:Name="AssistantOutputTextBox"
                                     Grid.Row="3"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Margin="16,0,0,0"
                        CornerRadius="12"
                        Padding="16"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelEdgeBrush}"
                        BorderThickness="1">
                    <TabControl x:Name="ActivityTabControl" SelectionChanged="TimelineTab_OnChanged">
                        <TabItem Header="Live events">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Latest 500 display entries. Timeline shows saved progress and evidence."
                                           TextWrapping="Wrap" Foreground="#526174" FontSize="12" Margin="0,8,0,4" />
                                <ListBox Margin="0,4,0,0" x:Name="EventsListBox" ItemsSource="{Binding Events}"
                                         FontFamily="Cascadia Code" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Workflow recovery">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshWorkflows_OnClick" Margin="8,0,0,8" />
                                        <TextBlock Text="Saved workflows" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ComboBox x:Name="WorkflowsComboBox" SelectionChanged="WorkflowSelection_OnChanged" DisplayMemberPath="Label" />
                                    <TextBlock Text="Invocation (root or child)" FontWeight="SemiBold" />
                                    <ComboBox x:Name="InvocationsComboBox" SelectionChanged="InvocationSelection_OnChanged" DisplayMemberPath="Label" />
                                    <TextBlock x:Name="WorkflowSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Button x:Name="ResumeWorkflowButton" Content="Resume root" Click="ResumeWorkflow_OnClick" />
                                        <Button x:Name="PauseWorkflowButton" Content="Pause root" Click="PauseWorkflow_OnClick" />
                                        <Button x:Name="CancelWorkflowButton" Content="Cancel root permanently" Click="CancelWorkflow_OnClick" Background="#B85A2A" />
                                    </WrapPanel>
                                    <TextBlock x:Name="RecoveryStatusTextBlock" TextWrapping="Wrap" Foreground="#7B351E" Margin="0,10,0,10" />
                                    <Expander Header="Lineage, tool outcomes, decisions and journal" IsExpanded="False" Margin="0,0,0,12">
                                        <TextBox x:Name="WorkflowDetailTextBox" IsReadOnly="True" AcceptsReturn="True"
                                                 TextWrapping="Wrap" Height="230" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                                    </Expander>
                                    <TextBlock Text="Pending question or exact operation approval" FontWeight="SemiBold" />
                                    <ComboBox x:Name="HumanRequestsComboBox" SelectionChanged="HumanRequestSelection_OnChanged" DisplayMemberPath="Label" />
                                    <TextBox x:Name="HumanRequestTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" MaxHeight="130" VerticalScrollBarVisibility="Auto" />
                                    <TextBox x:Name="AnswerTextBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                                             MaxHeight="150" VerticalScrollBarVisibility="Auto" />
                                    <WrapPanel>
                                        <Button x:Name="AnswerButton" Content="Submit answer and resume" Click="AnswerWorkflow_OnClick" />
                                        <Button x:Name="ApproveButton" Content="Approve and resume" Click="ApproveWorkflow_OnClick" />
                                        <Button x:Name="DenyButton" Content="Deny" Click="DenyWorkflow_OnClick" Background="#B85A2A" />
                                    </WrapPanel>
                                    <Expander Header="Reconcile an unknown tool outcome" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Record an outcome you have independently verified. This action does not execute the tool." TextWrapping="Wrap" Margin="0,8,0,4" />
                                            <ComboBox x:Name="UnknownToolsComboBox" DisplayMemberPath="Label" SelectionChanged="UnknownToolSelection_OnChanged" />
                                            <TextBox x:Name="UnknownToolTextBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
                                            <TextBlock Text="Established result" />
                                            <TextBox x:Name="ReconcileResultTextBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
                                            <CheckBox x:Name="ReconcileErrorCheckBox" Content="The established result is an error" Margin="0,0,0,8" />
                                            <TextBlock Text="Verification evidence / note" />
                                            <TextBox x:Name="ReconcileNoteTextBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
                                            <Button x:Name="ReconcileButton" Content="Record result and resume root" Click="ReconcileWorkflow_OnClick" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Task graphs" x:Name="TaskGraphsTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="10">
                                    <WrapPanel>
                                        <Button x:Name="ImportGraphButton" Content="Import graph manifest…" Click="ImportGraph_OnClick" />
                                        <Button x:Name="RefreshGraphsButton" Content="Refresh" Click="RefreshGraphs_OnClick" />
                                    </WrapPanel>
                                    <TextBlock x:Name="GraphManifestTextBlock" Text="Import a launch manifest to review its tasks, limits and verification commands." TextWrapping="Wrap" Margin="0,10,0,8" />
                                    <Expander Header="Imported manifest" Margin="0,0,0,8">
                                        <TextBox x:Name="GraphManifestTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                                    </Expander>
                                    <CheckBox x:Name="GraphLocalVerificationCheckBox" Content="Allow trusted local verification for this action (host OS authority)" Margin="0,0,0,8" Checked="GraphVerification_OnChanged" Unchecked="GraphVerification_OnChanged" />
                                    <TextBlock Text="Verification commands run repository code as this Windows user. Review the imported profiles before enabling this option. The worker is not an OS sandbox." TextWrapping="Wrap" FontSize="12" Foreground="#7B351E" Margin="0,0,0,8" />
                                    <Button x:Name="StartGraphButton" Content="Start imported graph" Click="StartGraph_OnClick" />
                                    <TextBlock Text="Saved graphs" FontWeight="SemiBold" Margin="0,14,0,0" />
                                    <ComboBox x:Name="GraphsComboBox" DisplayMemberPath="Label" SelectionChanged="GraphSelection_OnChanged" />
                                    <TextBlock x:Name="GraphSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Button x:Name="ResumeGraphButton" Content="Resume graph" Click="ResumeGraph_OnClick" />
                                        <Button x:Name="PauseGraphButton" Content="Pause graph" Click="PauseGraph_OnClick" />
                                        <Button x:Name="CancelGraphButton" Content="Cancel graph permanently" Click="CancelGraph_OnClick" Background="#B85A2A" />
                                    </WrapPanel>
                                    <TextBlock x:Name="GraphStatusTextBlock" TextWrapping="Wrap" Foreground="#7B351E" Margin="0,10,0,8" />
                                    <TextBlock Text="Task / dependencies / status / attempt" FontWeight="SemiBold" />
                                    <ComboBox x:Name="GraphTasksComboBox" DisplayMemberPath="Label" SelectionChanged="GraphTaskSelection_OnChanged" />
                                    <Button x:Name="RecoverGraphTaskButton" Content="Recover selected task invocation" Click="RecoverGraphTask_OnClick" />
                                    <Expander Header="Graph definition, artifacts, receipts, child invocations and journal" IsExpanded="True" Margin="0,8,0,8">
                                        <TextBox x:Name="GraphDetailTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="260" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                                    </Expander>
                                    <Expander Header="Reconcile an independently established outcome" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Select the exact saved operation, import its verified result JSON, and record your evidence. Recording a result does not execute or resume work." TextWrapping="Wrap" Margin="0,8,0,8" />
                                            <ComboBox x:Name="GraphReconciliationKindComboBox" SelectedIndex="0" SelectionChanged="GraphReconciliationKind_OnChanged">
                                                <ComboBoxItem Content="Task outcome" />
                                                <ComboBoxItem Content="Verification command outcome" />
                                                <ComboBoxItem Content="Child tool outcome" />
                                            </ComboBox>
                                            <ComboBox x:Name="GraphUnknownCommandsComboBox" DisplayMemberPath="Label" />
                                            <ComboBox x:Name="GraphUnknownToolsComboBox" DisplayMemberPath="Label" />
                                            <Button x:Name="ImportGraphResultButton" Content="Import verified result JSON…" Click="ImportGraphResult_OnClick" />
                                            <TextBox x:Name="GraphReconcileResultTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                                            <TextBlock Text="Independent verification evidence / note" />
                                            <TextBox x:Name="GraphReconcileNoteTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                            <Button x:Name="ReconcileGraphButton" Content="Record established outcome" Click="ReconcileGraph_OnClick" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Timeline" x:Name="ExecutionTimelineTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="10">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshTimeline_OnClick" Margin="8,0,0,8" />
                                        <TextBlock Text="Execution timeline" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ComboBox x:Name="TimelineRunsComboBox" DisplayMemberPath="Label" SelectionChanged="TimelineRun_OnChanged"
                                              ToolTip="{Binding SelectedItem.Id, RelativeSource={RelativeSource Self}}"
                                              AutomationProperties.Name="Saved execution" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <CheckBox x:Name="TimelineLiveCheckBox" Content="Refresh automatically" IsChecked="True" Margin="0,8,16,0"
                                                  Checked="TimelineLive_OnChanged" Unchecked="TimelineLive_OnChanged" />
                                        <Button x:Name="TimelineOpenControlsButton" Content="Open controls" Click="TimelineOpenControls_OnClick" IsEnabled="False" />
                                    </WrapPanel>
                                    <TextBlock x:Name="TimelineTitleTextBlock" Text="Choose a saved execution" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock x:Name="TimelineStateTextBlock" Text="No execution selected" FontWeight="SemiBold" Margin="0,6,0,4" />
                                    <ProgressBar x:Name="TimelineProgressBar" Minimum="0" Maximum="1" Height="7" Margin="0,4,0,10"
                                                 AutomationProperties.Name="Tasks accepted by host checks" />
                                    <TextBlock x:Name="TimelineSummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Text="The timeline shows saved progress and evidence. It does not start, resume or retry work." />
                                    <TextBlock Text="Tasks and checks" FontWeight="SemiBold" Margin="0,4,0,6" />
                                    <DataGrid x:Name="TimelineTasksGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                                              MaxHeight="220" MinHeight="80" SelectionChanged="TimelineTask_OnChanged" GridLinesVisibility="Horizontal"
                                              EnableRowVirtualization="True" AutomationProperties.Name="Task progress and verification">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="2*" MinWidth="80" ElementStyle="{StaticResource TimelineCellStyle}" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="76" ElementStyle="{StaticResource TimelineStatusStyle}" />
                                            <DataGridTextColumn Header="Waiting for" Binding="{Binding WaitingFor}" Width="*" MinWidth="76" ElementStyle="{StaticResource TimelineCellStyle}" />
                                            <DataGridTextColumn Header="Current work" Binding="{Binding Activity}" Width="2*" MinWidth="90" ElementStyle="{StaticResource TimelineCellStyle}" />
                                            <DataGridTextColumn Header="Checks" Binding="{Binding Checks}" Width="2*" MinWidth="110" ElementStyle="{StaticResource TimelineCellStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Expander Header="Selected task and saved evidence" Margin="0,8,0,10">
                                        <TextBox x:Name="TimelineTaskDetailsTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Height="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Saved task evidence" />
                                    </Expander>
                                    <TextBlock x:Name="TimelineEventsTextBlock" Text="Saved activity" FontWeight="SemiBold" Margin="0,4,0,6" />
                                    <ListBox x:Name="TimelineEventsListBox" MaxHeight="250" MinHeight="90" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="Saved execution activity">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3,5" ToolTip="{Binding Id}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeLabel}" Foreground="#526174" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Actor}" TextTrimming="CharacterEllipsis" Margin="4,0,10,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Title}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="TimelineStatusTextBlock" TextWrapping="Wrap" FontSize="12" Foreground="#526174" Margin="0,10,0,4" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="WorkflowSettingsTab" Header="Workflow settings">
                            <Expander x:Name="AdvancedSettingsExpander" Header="New workflow limits and approvals" IsExpanded="True" Margin="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Tool access for new workflows" />
                                    <ComboBox x:Name="ToolProfileComboBox" SelectedIndex="0">
                                        <ComboBoxItem Content="Coding" Tag="Coding" /><ComboBoxItem Content="Web browsing" Tag="Web" /><ComboBoxItem Content="All available tools" Tag="Full" />
                                    </ComboBox>
                                    <Button x:Name="LoadBrowserButton" Content="Review JavaScript browser sites…" Click="LoadBrowser_OnClick" />
                                    <TextBlock x:Name="BrowserStatusTextBlock" Text="Basic browsing. Choose web browsing or all available tools to use web tools." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,4" />
                                    <Button x:Name="LoadConnectorsButton" Content="Review connector configuration…" Click="LoadConnectors_OnClick" />
                                    <CheckBox x:Name="EnableConnectorsCheckBox" Content="Enable the reviewed connectors for new workflows" Margin="0,8,0,8" IsEnabled="False" />
                                    <TextBlock x:Name="ConnectorsStatusTextBlock" Text="Connectors are disabled. Each enabled operation requires approval." TextWrapping="Wrap" FontSize="12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Token limit (optional)" FontSize="12" />
                                            <TextBox x:Name="TokenLimitTextBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Execution seconds (optional)" FontSize="12" />
                                            <TextBox x:Name="ExecutionLimitTextBox" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Tools requiring approval (comma-separated names)" TextWrapping="Wrap" FontSize="12" />
                                    <TextBox x:Name="ApprovalToolsTextBox" />
                                    <TextBlock Text="Limits cover the root and its agents. Paused time and waiting for answers do not consume execution time." TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                </ScrollViewer>
                            </Expander>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
