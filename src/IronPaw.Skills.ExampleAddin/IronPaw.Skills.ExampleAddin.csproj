<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IronPaw.AgentCore.Abstractions\IronPaw.AgentCore.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="CopyBuiltAddin" AfterTargets="Build">
    <PropertyGroup>
      <AddinsDirectory>$(MSBuildProjectDirectory)\..\..\addins\skills</AddinsDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(AddinsDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AddinsDirectory)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(AddinsDirectory)"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
